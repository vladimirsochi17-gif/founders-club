# Server-only configuration. Copy to .env.supabase (git-ignored).
# Never use VITE_ prefixes for database credentials or Supabase secret keys.
NODE_ENV=development
PUBLIC_SANDBOX=true
SERVE_STATIC=true
PORT=8787
APP_ORIGIN=https://YOUR-SERVICE.onrender.com
DATABASE_SCHEMA=founders_sandbox
DATABASE_POOL_MAX=4
# Copy the SESSION POOLER connection string from Supabase Connect, with TLS.
# Session mode is required by the migration advisory lock; do not use transaction port 6543.
DATABASE_URL=postgresql://postgres.sldkfgsgipomyttoxmed:PASSWORD@SESSION-POOLER-HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt
SUPABASE_PROJECT_REF=sldkfgsgipomyttoxmed
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://sldkfgsgipomyttoxmed.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=founders-media
AUTH_HASH_SECRET=
SESSION_COOKIE_NAME=fc_sandbox_session
LOCAL_AUTH_DEV_CODE=
PAYMENTS_MODE=mock
SEED_DEMO=true
SMTP_HOST=
TRUST_PROXY=1
